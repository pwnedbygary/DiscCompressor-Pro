{
  "name": "disccompressor-pro",
  "version": "2.0.0",
  "description": "Convert disc images between BIN/CUE, GDI, ISO, CHD, CSO and ZSO",
  "author": "DiscCompressor",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run src/main/jobs/integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tools:win": "node scripts/fetch-windows-tools.mjs",
    "tools:linux": "bash scripts/build-linux-tools.sh",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "clean": "node -e \"for (const d of ['out','release']) require('node:fs').rmSync(d, { recursive: true, force: true })\""
  },
  "dependencies": {
    "koffi": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "7z-wasm": "^1.2.0",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  }
}
